{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stratbook",
  "version": "1.2.0",
  "identifier": "com.grxywxn.stratbook",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Stratbook",
        "width": 1400,
        "height": 880,
        "minWidth": 1040,
        "minHeight": 640,
        "center": true,
        "theme": "Dark",
        "additionalBrowserArgs": "--disable-features=msWebOoUI,msPdfOOUI,msSmartScreenProtection",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}